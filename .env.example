# Local origin. Production must use https://savage-library.vercel.app for both.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Shared authentication encryption secret.
AUTH_SECRET=replace-with-a-long-random-secret

# Generate this value with `npm run auth:hash-admin-password`.
ADMIN_PASSWORD_HASH=scrypt$salt$hash

# Neon Postgres connection string.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Vercel Preview only: enable after confirming BOTH database URL variables target
# a separate development database. Leave unset for unconfirmed/shared databases.
SAVAGE_LIBRARY_PREVIEW_DATABASE_CONFIRMED=

# Patreon API v2 OAuth client and Savage Library campaign.
# Member sign-in/linking only. Creator authorization and sync are unaffected.
# Change to true and restart/redeploy to restore new member connections.
PATREON_MEMBER_CONNECTIONS_ENABLED=false
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_CAMPAIGN_ID=
PATREON_CAMPAIGN_URL=https://www.patreon.com/

# Creator token used only to synchronize the campaign's tier catalog.
PATREON_CREATOR_ACCESS_TOKEN=
PATREON_CREATOR_REFRESH_TOKEN=
PATREON_WEBHOOK_SECRET=
CRON_SECRET=
EMAIL_SERVER=
EMAIL_FROM=
PATREON_TOKEN_ENCRYPTION_KEY=

# Vercel Blob stores: one public store for images and one private store for files.
PUBLIC_MEDIA_BLOB_READ_WRITE_TOKEN=
# Optional explicit name. When omitted, the managed Vercel Blob
# BLOB_READ_WRITE_TOKEN is used for private content.
PRIVATE_CONTENT_BLOB_READ_WRITE_TOKEN=
